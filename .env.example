# There is no LLM API key here, and that is the point.
#
# Reasoning runs through an agent CLI you already have a subscription seat on:
#   provider = "claude_cli"  → `claude`  (Claude Code, OAuth login)
#   provider = "codex_cli"   → `codex`   (Codex, ChatGPT login)
#
# Sign in once by running `claude` (or `codex login`), then check the whole
# chain with `co-scientist doctor`. Any ANTHROPIC_API_KEY / OPENAI_API_KEY in
# your environment is deliberately stripped from the CLI subprocess so a call
# can never silently fall back to metered API billing.

# Embeddings — the one hosted model this project still calls directly.
# No agent CLI exposes an embedding endpoint, and Proximity/dedup needs real
# semantic vectors. Without this, dedup degrades to a local hash embedder that
# only catches literal token overlap.
OPENAI_API_KEY=

# Web search (Tavily primary, Brave fallback). With neither set, the
# `web_search` tool is not registered at all and agents rely on
# PubMed / arXiv / Europe PMC, which need no key.
TAVILY_API_KEY=
BRAVE_API_KEY=

# Optional: improves PubMed / OpenAlex rate limits.
NCBI_API_KEY=
OPENALEX_API_KEY=
